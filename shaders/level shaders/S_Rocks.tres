	    vec4 result2 = pBlend / (vec4(2.0,2.0,2.0,2.0) * (vec4(1,1,1,1) - pBase));
	    vec4 zeroOrOne = step( vec4(0.5,0.5,0.5,0.5), pBase);
	    Out = result2 * zeroOrOne + (vec4(1,1,1,1) - zeroOrOne) * result1;
