// Vector4Constant:43
	vec4 n_out43p0 = vec4(0.000000, 0.000000, 0.000000, 0.000000);


	vec4 n_out42p0;
// Expression:42
	n_out42p0 = vec4(0.0, 0.0, 0.0, 0.0);
	{
		//BranchNode:42
		if ( n_out41p0 )
			n_out42p0 = n_out47p0;
		else
			n_out42p0 = n_out43p0;
		
