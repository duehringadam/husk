// Clamp:63
	vec3 n_in63p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in63p2 = vec3(100000.00000, 100000.00000, 100000.00000);
	vec3 n_out63p0 = clamp(vec3(n_out42p0.xyz), n_in63p1, n_in63p2);


// VectorOp:64
	vec4 n_in64p1 = vec4(100000.00000, 100000.00000, 100000.00000, 100000.00000);
	vec4 n_out64p0 = vec4(n_out63p0, 0.0) * n_in64p1;


// FloatParameter:38
	float n_out38p0 = AOIntensity;


// FloatOp:56
	float n_out56p0 = n_out17p2 * n_out38p0;


// FloatOp:37
	float n_out37p0 = n_out17p1 * n_out38p0;


	float n_out55p0;
// Expression:55
	n_out55p0 = 0.0;
