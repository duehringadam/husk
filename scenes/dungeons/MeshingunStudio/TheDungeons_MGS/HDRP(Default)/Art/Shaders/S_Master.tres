		float luma = dot( vec3(n_out25p0.xyz), vec3(0.2126729, 0.7151522, 0.0721750));
		n_out27p0 = vec3(luma,luma,luma) + vec3(n_out28p0,n_out28p0,n_out28p0) * ( vec3(n_out25p0.xyz) - vec3(luma,luma,luma) );
		
	}


