[sub_resource type="Shader" id="Shader_bbgol"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;

uniform sampler2D noise_texture : repeat_enable;
uniform vec2 noise_speed = vec2(0.0, 1.5);
uniform float noise_scale = 1.0;
uniform float distortion_strength = 0.03;
uniform float noise_blend = 0.6;

void fragment() {
	vec2 noise_uv = (UV * noise_scale) + (TIME * noise_speed);
	vec2 noise_val = texture(noise_texture, noise_uv).rg * 2.0 - 1.0; // map from [0.0, 1.0] to [-1.0, 1.0]

	vec2 center_uv = UV * 2.0 - 1.0;
	float dist = length(center_uv);
	float noisy_dist = dist + (noise_val.x * 0.3); 
	float edge_mask = clamp(1.0 - smoothstep(0.0, 1.0, noisy_dist), 0.0, 1.0);
	float time_offset_x = sin(TIME * 25.0 + UV.y * 8.0);
	float time_offset_y = cos(TIME * 20.0 + UV.x * 8.0);
	vec2 sine_wobble = vec2(time_offset_x, time_offset_y);
	vec2 wobble = mix(sine_wobble, noise_val, noise_blend);
	vec2 offset = wobble * distortion_strength * edge_mask * COLOR.a;

	ALBEDO = texture(screen_texture, SCREEN_UV + offset).rgb;
	ALPHA = edge_mask * COLOR.a;
}"

